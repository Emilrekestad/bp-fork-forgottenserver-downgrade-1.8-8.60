<?xml version="1.0" encoding="UTF-8"?>
<!--
	Ferumbras -- once a week on average.

	Spawns in the throne room of Ferumbras' Citadel (floor 4), the spot the
	owner picked in RME. The room already holds a Demon spawn, so the tiles
	are known to exist. Checked in RME: the room runs about x 32115-32127,
	y 32682-32696, so the escort radius is kept at 5 to stay inside it.

	The boss lands before its escort, on the tile the owner picked.
-->
<raid>
	<announce delay="1000" type="event" message="Ferumbras has been sighted in his citadel!" />

	<singlespawn delay="4000" name="Ferumbras" x="32121" y="32689" z="4" />

	<areaspawn delay="6000" radius="5" centerx="32121" centery="32689" centerz="4">
		<monster name="Demon" amount="6" />
	</areaspawn>
</raid>
