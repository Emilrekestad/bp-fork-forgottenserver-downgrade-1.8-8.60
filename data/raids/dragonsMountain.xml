<!--
	Dragons Mountain -- twice a day on average.

	This raid used to point at centerx="1146" centery="1112". No tile on this
	map is anywhere near that: map.probe found 0 of 1369 tiles present in the
	box. It announced nine times and spawned nothing, 1260 failed placements in
	the log. The coordinates below are the mountain where Dragons and Dragon
	Lords already spawn, and every box was probed before it was written:

		33221, 31296, 5  -- 32.8% usable   (Dragon Lord territory)
		33260, 31339, 5  -- 27.7% usable   (Dragon Lord territory)
		33304, 31295, 5  -- 27.0% usable   (Dragon territory)
		33180, 31298, 7  -- 24.8% usable   (Dragon territory)

	"Usable" is the exact test AreaSpawnEvent applies: the tile exists, is not
	moveable-blocking, is not a protection zone, and has no creature on it. The
	engine draws a random tile from the box and gives up after 10 tries per
	monster, so density is what decides whether a raid happens -- not whether
	the centre point looks right.

	Re-probe before moving any coordinate in this file.
-->
<raid>
	<announce delay="1000" type="event" message="Dragons are attacking in Dragons Mountain!" />

	<!-- Upper mountain (z = 5): the dragon lords' floor. -->
	<areaspawn delay="4000" radius="12" centerx="33221" centery="31296" centerz="5">
		<monster name="Dragon Lord" amount="6" />
		<monster name="Dragon Lord Hatchling" amount="6" />
	</areaspawn>

	<areaspawn delay="4000" radius="12" centerx="33260" centery="31339" centerz="5">
		<monster name="Dragon Lord" amount="6" />
	</areaspawn>

	<areaspawn delay="4000" radius="12" centerx="33304" centery="31295" centerz="5">
		<monster name="Dragon" amount="8" />
	</areaspawn>

	<!-- Lower mountain (z = 7): the dragons' floor. -->
	<areaspawn delay="8000" radius="12" centerx="33180" centery="31298" centerz="7">
		<monster name="Dragon" amount="10" />
		<monster name="Dragon Hatchling" amount="8" />
	</areaspawn>

	<announce delay="12000" type="event" message="The mountain is crawling with dragons!" />
</raid>
